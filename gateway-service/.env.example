NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/apishield

# Redis
REDIS_URL=redis://redis:6379

# Gateway
DEFAULT_RATE_LIMIT=100
DEFAULT_WINDOW_SECONDS=60
EVENT_QUEUE_KEY=event_queue
MAX_QUEUE_SIZE=100000
PROXY_TIMEOUT_MS=10000
DEFAULT_TARGET_URL=

# Admin
ADMIN_SECRET_KEY=change_me_in_production_please

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=false

# ── APIShield Pro — Root Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# Admin secret key (used by gateway admin routes)
ADMIN_SECRET_KEY=change_me_in_production_please_use_a_long_random_string

# Rate limiting defaults
DEFAULT_RATE_LIMIT=100
DEFAULT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info

# MongoDB (if using external)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/apishield

# Redis (if using external)
# REDIS_URL=redis://:password@host:6379
